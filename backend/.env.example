# ── INSURE Backend Environment Variables (.env.example) ──────────────────────
# Copy this file to .env and fill in real values. NEVER commit real credentials.

# ── Server Configuration ──────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# ── Supabase PostgreSQL Database (Required for persistent storage) ───────────
# Get this from Supabase Dashboard -> Settings -> Database -> Connection string (URI)
# Use Transaction Pooler (Port 6543) or Session Pooler (Port 5432)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
DATABASE_SSL=true

# ── Supabase API Client (Optional fallback / Auth verification) ───────────────
# Get these from Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── CORS & Deployed Frontend Origins ──────────────────────────────────────────
# Comma-separated list of allowed frontend origins (e.g. Vercel deployment URL)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
FRONTEND_URL=https://your-frontend.vercel.app

# ── Demo Identity & Auth ──────────────────────────────────────────────────────
DEMO_USER_ID=00000000-0000-0000-0000-000000000001
JWT_SECRET=your-secure-jwt-secret-key-here
JWT_EXPIRES_IN=7d
OTP_SALT=your-otp-salt-secret-here

# ── Brevo Email Relay (Transactional Email & OTP verification) ───────────────
BREVO_API_KEY=your-brevo-api-key-here
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@smtp-brevo.com
SMTP_PASS=your-smtp-pass-here
SMTP_FROM_EMAIL=your-verified-sender@example.com
SMTP_FROM_NAME=INSURE

# ── AI Explanations (Optional) ────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Actuarial Pricing & Risk Scoring Rules ────────────────────────────────────
CURRENCY=INR
CURRENCY_SYMBOL=₹
BASE_PREMIUM=2000
MAX_RISK_ADJUSTMENT=0.5
PRICING_RULE_VERSION=v2.1-profitability
SCORE_RULE_VERSION=v2.1-profitability

# ── IoT Device Authentication (Mandatory in production) ────────────────────────
# High-entropy API key required for physical / deployed IoT devices to ingest telemetry.
# In production (NODE_ENV=production), this variable is MANDATORY; missing key fails closed.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IOT_INGEST_API_KEY=your-high-entropy-device-ingest-api-key-here

