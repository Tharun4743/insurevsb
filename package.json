{
  "name": "insure-root",
  "version": "1.0.0",
  "description": "INSURE — Smarter Driving. Fairer Insurance.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "start:backend": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend test",
    "test": "npm --prefix backend test"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "keywords": [
    "telematics",
    "insurance",
    "behavior-based",
    "react",
    "nodejs",
    "typescript"
  ],
  "author": "INSURE Team",
  "license": "UNLICENSED"
}
