# ── INSURE Frontend Environment Configuration ────────────────────────────────
# In production on Vercel, set this to your deployed Render backend URL.
# Example: https://insure-backend.onrender.com
VITE_API_BASE_URL=https://your-backend-api.onrender.com

# Optional: Override local dev proxy target (defaults to http://localhost:3001)
# VITE_API_PROXY_TARGET=http://localhost:3001
