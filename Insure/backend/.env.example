# ── INSURE Backend Environment Variables (.env.example) ──────────────────────
# Copy this file to .env and fill in real values. NEVER commit real credentials.

# ── Server Configuration ──────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# ── Supabase PostgreSQL Database (Required for persistent storage) ───────────
# Get this from Supabase Dashboard -> Settings -> Database -> Connection string (URI)
# Use Transaction Pooler (Port 6543) or Session Pooler (Port 5432)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
DATABASE_SSL=true

# ── Supabase API Client (Optional fallback / Auth verification) ───────────────
# Get these from Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── CORS & Deployed Frontend Origins ──────────────────────────────────────────
# Comma-separated list of allowed frontend origins (e.g. Vercel deployment URL)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
FRONTEND_URL=https://your-frontend.vercel.app

# ── Demo Identity & Auth ──────────────────────────────────────────────────────
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# ── AI Explanations (Optional) ────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Actuarial Pricing & Risk Scoring Rules ────────────────────────────────────
CURRENCY=INR
CURRENCY_SYMBOL=₹
BASE_PREMIUM=2000
MAX_RISK_ADJUSTMENT=0.5
PRICING_RULE_VERSION=v2.1-profitability
SCORE_RULE_VERSION=v2.1-profitability
