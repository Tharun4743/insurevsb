# ── INSURE Monorepo Environment Variables Reference ─────────────────────────
# Copy this file to backend/.env and frontend/.env respectively.
# Never commit real secrets to Git.

# ==============================================================================
# BACKEND (backend/.env)
# ==============================================================================
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Supabase Database URL (Transaction Pooler port 6543 recommended)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
DATABASE_SSL=true

# Supabase Project API Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Allowed Frontend Origins (Comma-separated)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
FRONTEND_URL=https://your-frontend.vercel.app

# Actuarial & Business Configuration
DEMO_USER_ID=00000000-0000-0000-0000-000000000001
CURRENCY=INR
CURRENCY_SYMBOL=₹
BASE_PREMIUM=2000
MAX_RISK_ADJUSTMENT=0.5
PRICING_RULE_VERSION=v2.1-profitability
SCORE_RULE_VERSION=v2.1-profitability

# Optional Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here

# ==============================================================================
# FRONTEND (frontend/.env)
# ==============================================================================
# URL of your deployed backend on Render (or local proxy in dev)
VITE_API_BASE_URL=https://your-backend-api.onrender.com
