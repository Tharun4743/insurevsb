{
  "version": 1,
  "author": "INSURE IoT Team",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-mpu6050",
      "id": "mpu",
      "top": -120,
      "left": -120,
      "attrs": {}
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_impact",
      "top": -90,
      "left": 200,
      "attrs": { "color": "red", "label": "Impact / Collision Trigger" }
    },
    {
      "type": "wokwi-slide-switch",
      "id": "sw_helmet",
      "top": -90,
      "left": 80,
      "attrs": { "label": "Helmet Sensor (LEFT=ON / RIGHT=OFF)" }
    }, 
    {
      "type": "wokwi-potentiometer",
      "id": "pot_alcohol",
      "top": 40,
      "left": 200,
      "attrs": { "label": "Simulated Alcohol Sensor (ppm)" }
    },
    {
      "type": "wokwi-led",
      "id": "led_green",
      "top": -30,
      "left": -60,
      "attrs": { "color": "green", "label": "Normal / Connected" }
    },
    {
      "type": "wokwi-led",
      "id": "led_red",
      "top": -75,
      "left": -60,
      "attrs": { "color": "red", "label": "Collision Alert" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 120,
      "left": -60,
      "attrs": { "label": "Collision Siren" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 20,
      "left": -60,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": 60,
      "left": -60,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "mpu:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "mpu:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "mpu:SDA", "esp:21", "blue", [ "v0" ] ],
    [ "mpu:SCL", "esp:22", "yellow", [ "v0" ] ],

    [ "btn_impact:1.l", "esp:18", "red", [ "v0" ] ],
    [ "btn_impact:2.l", "esp:GND.2", "black", [ "v0" ] ],

    [ "sw_helmet:1", "esp:19", "green", [ "v0" ] ],
    [ "sw_helmet:2", "esp:GND.2", "black", [ "v0" ] ],

    [ "pot_alcohol:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "pot_alcohol:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "pot_alcohol:SIG", "esp:34", "purple", [ "v0" ] ],

    [ "esp:25", "r1:1", "green", [ "v0" ] ],
    [ "r1:2", "led_green:A", "green", [ "v0" ] ],
    [ "led_green:C", "esp:GND.1", "black", [ "v0" ] ],

    [ "esp:26", "r2:1", "red", [ "v0" ] ],
    [ "r2:2", "led_red:A", "red", [ "v0" ] ],
    [ "led_red:C", "esp:GND.1", "black", [ "v0" ] ],

    [ "esp:27", "buzzer:1", "orange", [ "v0" ] ],
    [ "buzzer:2", "esp:GND.1", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
